{
  "name": "espaceco",
  "private": true,
  "version": "0.0.15",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./scripts/prepare-app.js && tsc -b && vite build",
    "build-dev": "node ./scripts/prepare-app.js && tsc -b && vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "selectapp": "node ./scripts/selectapp.js && npm run build",
    "selectapp:naviforest": "node ./scripts/selectapp.js --naviforest && npm run build",
    "selectapp:espaceco": "node ./scripts/selectapp.js --espaceco && npm run build",
    "generate-apk": "bash ./scripts/generate-apk.sh",
    "capacitor-build-dev": "npm run build-dev && npx cap sync",
    "capacitor-build": "npm run build && npx cap sync",
    "capacitor-run-ios": "npm run capacitor-build && npx cap run ios",
    "capacitor-run-ios-dev": "npm run capacitor-build-dev && npx cap run ios",
    "capacitor-run-android": "npm run capacitor-build && npx cap run android",
    "capacitor-run-android-dev": "npm run capacitor-build-dev && npx cap run android",
    "open-xcode": "npx cap open ios",
    "open-android": "npx cap open android",
    "deploy:ios": "node ./scripts/deploy.js ios",
    "deploy:android": "node ./scripts/deploy.js android",
    "deploy": "node ./scripts/deploy.js both"
  },
  "dependencies": {
    "@capacitor-community/device": "^8.0.0",
    "@capacitor-community/keep-awake": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/device": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/inappbrowser": "^3.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/status-bar": "^8.0.2",
    "@capacitor/toast": "^8.0.0",
    "@dnd-kit/react": "^0.3.2",
    "@ign/mobile-core": "https://github.com/IGNF/mobile-core.git#main",
    "@ign/mobile-device": "https://github.com/IGNF/mobile-device.git#main",
    "@ionic/pwa-elements": "^3.3.0",
    "capacitor-email-composer": "^8.0.0",
    "collaboratif-client-api": "github:IGNF/collaboratif-client-api#2.0",
    "cordova-plugin-bluetooth-geolocation": "github:viglino/cordova-plugin-bluetooth-geolocation",
    "cordova-plugin-bluetooth-serial": "github:giuseppelanzi/BluetoothSerial",
    "cordova-plugin-geolocation": "^4.0.2",
    "cordova-plugin-listpicker": "^2.2.2",
    "i18next": "^25.7.3",
    "install": "^0.13.0",
    "npm": "^11.7.0",
    "ol": "^10.7.0",
    "ol-ext": "^4.0.37",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.1",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/ol-ext": "npm:@siedlerchr/types-ol-ext@^3.6.5",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-svgr": "^4.5.0"
  }
}
